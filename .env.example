# ─────────────────────────────────────────────────────────────
#  Kayalar Motors — LP1
#  Copy to .env for local dev. In production set these in
#  Cloudflare Pages > Settings > Environment variables.
# ─────────────────────────────────────────────────────────────

# --- Public (compiled into the page) -------------------------
# Final subdomain. Drives canonical, hreflang and og:url.
PUBLIC_SITE_URL=https://lp1-kayalar.pages.dev

# Supplied in the brief. Same pixel on LP1 and LP2 (one campaign).
PUBLIC_META_PIXEL_ID=28341044768871070

# Still pending — each stays inert until filled in.
# GTM container for LP1 is already the built-in default (GTM-P82QQLJ8).
# Only needs a value here to point at a different container.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
# CallRail DNI. The LP1 swap script is already the built-in default, so this
# only needs a value to point at a different CallRail company or number pool.
PUBLIC_CALLRAIL_SWAP_SRC=
PUBLIC_GSC_VERIFICATION=

# Section 3 says per-form on-page confirmations, so this stays false.
# Set to true to redirect to /thank-you instead.
PUBLIC_REDIRECT_AFTER_SUBMIT=false

# TCPA checkbox default. The brief asks for pre-checked (true).
# See README, "Legal note", before launch.
PUBLIC_CONSENT_PRECHECKED=true

# Milliseconds after page load before the automatic pop-up may fire.
# Default is 8000 for this page.
PUBLIC_POPUP_DELAY_MS=

# Cloudflare Turnstile public key. Empty = no widget, no verification.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never compiled into the page) --------------
CRM_ENDPOINT=
CRM_AUTH_HEADER=
CRM_AUTH_VALUE=
LEAD_BACKUP_WEBHOOK=
META_CAPI_TOKEN=
# Temporary, for validating the CAPI wiring only. Paste the code from
# Events Manager > Test Events, redeploy, send one test lead, then CLEAR it.
META_TEST_EVENT_CODE=
META_PIXEL_ID=28341044768871070
LEAD_DEBUG=false

# Turnstile secret, from the same widget as PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# "false" verifies and logs but still accepts the lead. Launch in this mode for
# a few days, check the logs, then remove it to start rejecting.
TURNSTILE_ENFORCE=
