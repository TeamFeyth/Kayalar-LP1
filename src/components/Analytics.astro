---
/**
 * Section 4 — Analytics, Pixel & Snippet Registry.
 *
 * Meta Pixel is hard-wired (the ID was supplied in the brief). Every other tag
 * renders only when its env var is filled in, so nothing breaks while those
 * fields are still "(blank)".
 */
import { site, tracking } from '../config/site';

const { metaPixelId, gtmId, ga4Id, callRailSwapSrc, searchConsoleToken } = tracking;
---

{searchConsoleToken && <meta name="google-site-verification" content={searchConsoleToken} />}

{/* ---- Meta Pixel ---- */}
<script is:inline define:vars={{ metaPixelId }}>
  !(function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', metaPixelId);
  fbq('track', 'PageView');
</script>
<noscript
  set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1" alt="" />`}
/>

{/* ---- Google Tag Manager ---- */}
{
  gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);`}
    </script>
  )
}

{/* ---- GA4 (skip if GA4 is already deployed through GTM) ---- */}
{
  ga4Id && !gtmId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
        gtag('js',new Date());gtag('config',ga4Id);`}
      </script>
    </>
  )
}

{/* ---- CallRail Dynamic Number Insertion ----
     Loaded without `async` on purpose. swap.js rewrites the phone numbers and
     the tel: links, and the numbers here sit above the fold, including the
     floating call button on mobile. Loaded async on a slow connection it can
     land after first paint, which means a tap in that window dials the static
     number and the call goes unattributed — the one thing CallRail is here to
     prevent. The preconnect below covers most of the cost of loading it early.
     If PageSpeed ever makes this a problem, adding `async` back is a one-word
     change. */}
{
  callRailSwapSrc && (
    <>
      <link rel="preconnect" href="https://cdn.callrail.com" />
      <link rel="dns-prefetch" href="https://cdn.callrail.com" />
      <script is:inline src={callRailSwapSrc} />
    </>
  )
}

{/* ---- Cloudflare Turnstile ----
     Rendered explicitly rather than by class scan, because two of the four
     forms live inside the pop-up and are hidden at load. Explicit rendering
     issues a token for those too, so a visitor who opens the pop-up and submits
     straight away is never held up waiting for a challenge to start.
     The callback is defined before the library so it exists when it loads. */}
{
  site.turnstileSiteKey && (
    <>
      <script is:inline>
        {`window.__kmTurnstileReady = function () {
          document.querySelectorAll('[data-turnstile]').forEach(function (el) {
            if (el.dataset.rendered) return;
            el.dataset.rendered = '1';
            window.turnstile.render(el, {
              sitekey: el.getAttribute('data-sitekey'),
              'refresh-expired': 'auto',
            });
          });
        };`}
      </script>
      <script
        is:inline
        async
        defer
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__kmTurnstileReady"
      />
    </>
  )
}

{/* dataLayer must exist even without GTM so form events never throw. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
</script>
