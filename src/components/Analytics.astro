---
/**
 * Section 4 — Analytics, Pixel & Snippet Registry.
 *
 * Meta Pixel is hard-wired (the ID was supplied in the brief). Every other tag
 * renders only when its env var is filled in, so nothing breaks while those
 * fields are still "(blank)".
 */
import { site, tracking } from '../config/site';

const { metaPixelId, gtmId, ga4Id, searchConsoleToken } = tracking;
---

{searchConsoleToken && <meta name="google-site-verification" content={searchConsoleToken} />}

{/* NOTE: the bodies of these is:inline scripts are raw JavaScript, never
    wrapped in a {`...`} template literal. With is:inline, Astro copies the
    contents verbatim, so the wrapper gets emitted literally and turns the whole
    snippet into an inert string. It parses cleanly and silently does nothing.
    Keep the Meta Pixel block below as the reference for the correct shape. */}

{/* ---- Meta Pixel ---- */}
<script is:inline define:vars={{ metaPixelId }}>
  !(function (f, b, e, v, n, t, s) {
    if (f.fbq) return;
    n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
    };
    if (!f._fbq) f._fbq = n;
    n.push = n;
    n.loaded = !0;
    n.version = '2.0';
    n.queue = [];
    t = b.createElement(e);
    t.async = !0;
    t.src = v;
    s = b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t, s);
  })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  // One visitor id (32 random bytes, hex) kept for two years, and one id per
  // page view. The pixel and /api/pageview send the same ids, so Meta pairs
  // the browser and server PageView and counts the view once.
  var lpVid = (function () {
    try {
      var m = document.cookie.match(/(?:^|; )lp_vid=([a-f0-9]{64})/);
      if (m) return m[1];
      var b = new Uint8Array(32);
      crypto.getRandomValues(b);
      var v = Array.prototype.map.call(b, function (x) { return ('0' + x.toString(16)).slice(-2); }).join('');
      document.cookie = 'lp_vid=' + v + '; Max-Age=63072000; Path=/; SameSite=Lax; Secure';
      return v;
    } catch (e) {
      return '';
    }
  })();
  window.__lpVid = lpVid;
  var lpPvId = window.crypto && crypto.randomUUID
    ? crypto.randomUUID()
    : Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
  fbq('init', metaPixelId, lpVid ? { external_id: lpVid } : {});
  fbq('track', 'PageView', {}, { eventID: lpPvId });
  (function () {
    var sent = false;
    function ck(n) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + n + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    function send() {
      if (sent) return;
      sent = true;
      var fbclid = new URLSearchParams(location.search).get('fbclid');
      var body = JSON.stringify({
        event_id: lpPvId,
        page_url: location.href,
        visitor_id: lpVid,
        fbp: ck('_fbp'),
        fbc: ck('_fbc') || (fbclid ? 'fb.1.' + Date.now() + '.' + fbclid : ''),
      });
      try {
        if (navigator.sendBeacon && navigator.sendBeacon('/api/pageview', new Blob([body], { type: 'text/plain' }))) return;
      } catch (e) {}
      try {
        fetch('/api/pageview', { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } });
      } catch (e) {}
    }
    // _fbp is written once fbevents.js loads; give it up to 3 seconds.
    var tries = 0;
    (function wait() {
      if (ck('_fbp') || ++tries > 15) return send();
      setTimeout(wait, 200);
    })();
    addEventListener('pagehide', send);
  })();
</script>
<noscript
  set:html={`<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1" alt="" />`}
/>

{/* ---- Google Tag Manager ---- */}
{
  gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
  )
}

{/* ---- GA4 (skip if GA4 is already deployed through GTM) ---- */}
{
  ga4Id && !gtmId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
    </>
  )
}


{/* ---- Cloudflare Turnstile ----
     Rendered explicitly rather than by class scan, because two of the four
     forms live inside the pop-up and are hidden at load. Explicit rendering
     issues a token for those too, so a visitor who opens the pop-up and submits
     straight away is never held up waiting for a challenge to start.
     The callback is defined before the library so it exists when it loads. */}
{
  site.turnstileSiteKey && (
    <>
      <script is:inline>
        window.__kmTurnstileReady = function () {
          document.querySelectorAll('[data-turnstile]').forEach(function (el) {
            if (el.dataset.rendered) return;
            el.dataset.rendered = '1';
            window.turnstile.render(el, {
              sitekey: el.getAttribute('data-sitekey'),
              'refresh-expired': 'auto',
            });
          });
        };
      </script>
      <script
        is:inline
        async
        defer
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__kmTurnstileReady"
      />
    </>
  )
}

{/* dataLayer must exist even without GTM so form events never throw. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
</script>
