---
import TopBar from './TopBar.astro';
import Hero from './Hero.astro';
import FeaturedVehicles from './FeaturedVehicles.astro';
import WhyChooseUs from './WhyChooseUs.astro';
import VisitLot from './VisitLot.astro';
import PreFooterLead from './PreFooterLead.astro';
import Footer from './Footer.astro';
import Popup from './Popup.astro';
import FormRuntime from './FormRuntime.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<a class="skip-link" href="#hero-form">{t.nav.skipToForm}</a>

<TopBar lang={lang} />

<main>
  <Hero lang={lang} />
  <FeaturedVehicles lang={lang} />
  <WhyChooseUs lang={lang} />
  <VisitLot lang={lang} />
  <PreFooterLead lang={lang} />
</main>

<Footer lang={lang} />
<Popup lang={lang} />
<FormRuntime />
