---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section--ink" id="why-us">
  <div class="wrap why__inner">
    <div class="why__intro">
      <h2>{t.why.heading}</h2>
      <img
        class="why__photo"
        src="/images/service-lot.webp"
        alt={t.why.photoAlt}
        width="900"
        height="506"
        loading="lazy"
        decoding="async"
      />
    </div>

    <ul class="why__list">
      {
        t.why.bullets.map((b) => (
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                d="M20 6 9 17l-5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }

  .why__inner h2 {
    margin: 0;
    color: var(--paper);
  }

  .why__photo {
    width: 100%;
    height: auto;
    margin-top: 22px;
    border-radius: var(--radius);
    border: 1px solid rgba(250, 248, 244, 0.14);
  }

  .why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .why__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(250, 248, 244, 0.14);
    font-size: 16.5px;
  }

  .why__list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .why__list svg {
    color: #e0777b;
    margin-top: 4px;
  }

  @media (max-width: 800px) {
    .why__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
