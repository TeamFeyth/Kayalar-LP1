---
import { site } from '../config/site';
import { useTranslations, alternatePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const enHref = alternatePath(Astro.url, 'en');
const esHref = alternatePath(Astro.url, 'es');
---

<header class="topbar">
  <div class="wrap topbar__inner">
    <a class="topbar__brand" href={lang === 'es' ? '/es/' : '/'}>
      <img src="/images/logo-dark.png" alt="Kayalar Motors" width="440" height="134" />
    </a>

    <div class="topbar__right">
      <nav class="langswitch" aria-label={t.nav.langLabel}>
        <a href={enHref} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">|</span>
        <a href={esHref} hreflang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
      </nav>

      <a class="topbar__call" href={site.phoneHref}>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
          <path
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
            fill="currentColor"></path>
        </svg>
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<style>
  .topbar {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 60;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 62px;
  }

  .topbar__brand {
    display: inline-flex;
    text-decoration: none;
  }

  .topbar__brand img {
    width: auto;
    height: 38px;
  }

  .topbar__right {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .langswitch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--graphite);
  }

  .langswitch a {
    text-decoration: none;
    padding: 2px 2px;
  }

  .langswitch a[aria-current] {
    color: var(--ink);
    border-bottom: 2px solid var(--red);
  }

  .topbar__call {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .topbar__call:hover {
    color: var(--red);
  }

  @media (max-width: 480px) {
    .topbar__call span {
      display: none;
    }
    .topbar__brand img {
      height: 30px;
    }
  }
</style>
